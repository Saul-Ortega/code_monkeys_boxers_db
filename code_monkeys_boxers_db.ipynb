"# CODE_MONKEYS_BOXERS_DB\n",
"\n",
"This is a program to take boxing data, store it in a SQLite database and manipulate it.\n",
"\n",
"## Requirements:\n",
"- Have the data.csv with the header: name;total_fights;wins;loses;draws and have all data separated in that exact format."
]
},
{
"cell_type": "code",
"execution_count": null,
"metadata": {
"id": "NYkfGOIRlmSX"
},
"outputs": [],
"source": [
"import pandas as pd\n",
"import sqlite3\n",
"\n",
"connection = sqlite3.connect("boxers.db")\n",
"cursor = connection.cursor()"
]
},
{
"cell_type": "code",
"execution_count": null,
"metadata": {
"id": "bMb5458TvW1s"
},
"outputs": [],
"source": [
"def read_file(path: str) -> pd.DataFrame | None:\n",
"    """\n",
"    Read a file with values separated by semicolons and store it in a DataFrame.\n",
"\n",
"    Args:\n",
"        path (str): Path of the file (e.g. path/to/the/file).\n",
"    Returns:\n",
"        pd.DataFrame | None: Pandas object with all csv data, or None if an error occurs.\n",
"    """\n",
"    try:\n",
"        dataframe = pd.read_csv(\n",
"            filepath_or_buffer=path,\n",
"            sep=";"\n",
"        )\n",
"        print("File read successfully")\n",
"        return dataframe\n",
"    except FileNotFoundError:\n",
"        print("Error: The file could not be loaded")\n",
"    except Exception as error:\n",
"        print("Unexpected error ->", error)\n",
"    return None\n",
"\n",
"\n",
"read_file("data.csv")"
]
},
{
"cell_type": "code",
"execution_count": null,
"metadata": {
"id": "8bqBzbDlqsLs"
},
"outputs": [],
"source": [
"def create_database() -> None:\n",
"    """\n",
"    Creates the database table of the boxers with the structure:\n",
"    id, name, total_fights, wins, loses, draws.\n",
"\n",
"    Returns:\n",
"        None\n",
"    """\n",
"    try:\n",
"        cursor.execute("""\n",
"            CREATE TABLE IF NOT EXISTS boxers (\n",
"                id INTEGER PRIMARY KEY,\n",
"                name TEXT,\n",
"                total_fights INTEGER,\n",
"                wins INTEGER,\n",
"                loses INTEGER,\n",
"                draws INTEGER\n",
"            )\n",
"        """)\n",
"        connection.commit()\n",
"        print("Database created successfully")\n",
"    except Exception as error:\n",
"        print("Unexpected error ->", error)\n",
"\n",
"\n",
"create_database()"
]
},
{
"cell_type": "code",
"execution_count": null,
"metadata": {
"id": "7iXMKda2Ene2"
},
"outputs": [],
"source": [
"def populate_table(dataframe: pd.DataFrame | None) -> None:\n",
"    """\n",
"    Inserts all data from dataframe to the boxers table to populate it.\n",
"\n",
"    Args:\n",
"        dataframe (pd.DataFrame | None): Pandas object that has all csv data.\n",
"\n",
"    Returns:\n",
"        None\n",
"    """\n",
"    if dataframe is None:\n",
"        print("Error: No data available to populate table.")\n",
"        return\n",
"\n",
"    try:\n",
"        dataframe.to_sql("boxers", con=connection, if_exists="replace", index_label="id")\n",
"        connection.commit()\n",
"        print("The table has been populated successfully")\n",
"    except Exception as error:\n",
"        print("Unexpected error ->", error)\n",
"\n",
"\n",
"dataframe = read_file("data.csv")\n",
"populate_table(dataframe)"
]
},
{
"cell_type": "code",
"execution_count": null,
"metadata": {
"id": "delBoxersCell1"
},
"outputs": [],
"source": [
"def delete_database(boxer: str | None = None) -> None:\n",
"    """\n",
"    Delete a specific boxer or all boxers from the database.\n",
"\n",
"    This function looks up a boxer by name and deletes their\n",
"    information from the database. If no boxer is specified,\n",
"    it deletes all the records from the database.\n",
"\n",
"    Args:\n",
"        boxer (str | None, optional): Name of the boxer to delete.\n",
"            Defaults to None to delete all records.\n",
"\n",
"    Returns:\n",
"        None\n",
"    """\n",
"    try:\n",
"        if boxer is None:\n",
"            cursor.execute("DELETE FROM boxers")\n",
"            print("All boxers deleted successfully")\n",
"        else:\n",
"            cursor.execute(\n",
"                "DELETE FROM boxers WHERE name = ?", (boxer,)\n",
"            )\n",
"\n",
"            if cursor.rowcount > 0:\n",
"                print("Boxer deleted successfully")\n",
"            else:\n",
"                print("Boxer not found")\n",
"\n",
"        connection.commit()\n",
"\n",
"    except Exception as error:\n",
"        connection.rollback()\n",
"        print("Unexpected error ->", error)"
]
},
