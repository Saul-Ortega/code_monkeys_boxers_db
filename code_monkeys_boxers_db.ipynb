"## Best and worst boxer (Facundo)\n",
"\n",
"Prints the best and worst boxer of the boxers table.\n",
"\n",
"- win_rate: wins / total fights * 100\n",
"- points: 3 per win + 1 per draw"
]
},
{
"cell_type": "code",
"execution_count": null,
"metadata": {
"id": "bestWorstCode1"
},
"outputs": [],
"source": [
"def show_best_and_worst_boxer(metric: str = "win_rate") -> None:\n",
"    """\n",
"    Find and print the best and worst boxers from the database.\n",
"\n",
"    Reads the boxer records from the database, calculates a score\n",
"    for each one based on their fight stats, and prints out the\n",
"    info of the highest and lowest ranked boxers.\n",
"\n",
"    Args:\n",
"        metric (str, optional): Criteria used to rank the boxers\n",
"            ("win_rate" or "points"). Defaults to "win_rate".\n",
"\n",
"    Returns:\n",
"        None\n",
"    """\n",
"    # Check that the metric is valid\n",
"    if metric not in ("win_rate", "points"):\n",
"        print("Metric not valid. Use 'win_rate' or 'points'.")\n",
"        return\n",
"\n",
"    try:\n",
"        # Read all the boxers from the database\n",
"        with sqlite3.connect("boxers.db") as conn:\n",
"            cur = conn.cursor()\n",
"            cur.execute("SELECT name, total_fights, wins, loses, draws FROM boxers")\n",
"            boxers = cur.fetchall()\n",
"    except Exception as error:\n",
"        print("Error reading database ->", error)\n",
"        return\n",
"\n",
"    # Variables to remember the best and the worst boxer\n",
"    best_name = None\n",
"    best_score = 0.0\n",
"    worst_name = None\n",
"    worst_score = 0.0\n",
"\n",
"    # Go through the boxers one by one\n",
"    for boxer in boxers:\n",
"        name = boxer[0]\n",
"        total_fights = boxer[1]\n",
"        wins = boxer[2]\n",
"        draws = boxer[4]\n",
"\n",
"        # Skip boxers without fights (we can't divide by zero)\n",
"        if total_fights == 0:\n",
"            continue\n",
"\n",
"        # Calculate the score\n",
"        if metric == "win_rate":\n",
"            score = (wins / total_fights) * 100\n",
"        else:\n",
"            score = (wins * 3) + draws\n",
"\n",
"        # Is it the first boxer, or is it better than the best so far?\n",
"        if best_name is None or score > best_score:\n",
"            best_name = name\n",
"            best_score = score\n",
"\n",
"        # Is it the first boxer, or is it worse than the worst so far?\n",
"        if worst_name is None or score < worst_score:\n",
"            worst_name = name\n",
"            worst_score = score\n",
"\n",
"    if best_name is None:\n",
"        print("There are no boxers to compare.")\n",
"        return\n",
"\n",
"    print("Ranking by:", metric)\n",
"    print("Best boxer:", best_name, "- score:", round(best_score, 2))\n",
"    print("Worst boxer:", worst_name, "- score:", round(worst_score, 2))\n",
"    print("-" * 40)"
]
},
