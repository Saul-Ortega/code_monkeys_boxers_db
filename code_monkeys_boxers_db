        "def delete_database(boxer: str | None = None) -> None:\n",
        "    \"\"\"\n",
        "    Delete a specific boxer or all boxers from the database.\n",
        "\n",
        "    This function looks up a boxer by name and deletes their\n",
        "    information from the database. If no boxer is specified,\n",
        "    it deletes all the records from the database.\n",
        "\n",
        "    Args:\n",
        "        boxer (str | None, optional): Name of the boxer to delete.\n",
        "            Defaults to None to delete all records.\n",
        "\n",
        "    Returns:\n",
        "        None\n",
        "    \"\"\"\n",
        "    try:\n",
        "        if boxer is None:\n",
        "            cursor.execute(\"DELETE FROM boxers\")\n",
        "            print(\"All boxers deleted successfully\")\n",
        "        else:\n",
        "            cursor.execute(\n",
        "                \"DELETE FROM boxers WHERE name = ?\", (boxer,)\n",
        "            )\n",
        "\n",
        "            if cursor.rowcount > 0:\n",
        "                print(\"Boxer deleted successfully\")\n",
        "            else:\n",
        "                print(\"Boxer not found\")\n",
        "\n",
        "        connection.commit()\n",
        "\n",
        "    except Exception as error:\n",
        "        connection.rollback()\n",
        "        print(\"Unexpected error ->\", error)"
      ]
